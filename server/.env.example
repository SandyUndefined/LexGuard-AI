# Server Environment Variables
# Copy this file to .env and fill in your values

# ─── Server ────────────────────────────────────────────
# Cloud Run injects PORT automatically. Use 3001 locally if desired.
PORT=3001
TRUST_PROXY=false
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# ─── Mock Mode (set to "true" to skip GCP calls) ───────
# When MOCK_MODE=true, the server skips GCP calls and stores newly created
# reports in memory. No reports are preloaded.
MOCK_MODE=true

# ─── Google Cloud Platform ──────────────────────────────
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Path to your GCP service account key JSON file
# Download from: GCP Console → IAM → Service Accounts → Keys
GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json

# ─── Google Cloud Storage ───────────────────────────────
GCS_BUCKET_NAME=lexguard-documents

# ─── Vertex AI ──────────────────────────────────────────
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_MODEL=gemini-2.5-flash

# ─── Firestore ──────────────────────────────────────────
# Uses the GOOGLE_CLOUD_PROJECT above
# Collection name for analysis results
FIRESTORE_COLLECTION=analyses
FIRESTORE_REPORTS_COLLECTION=reports

# ─── CORS ───────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,https://lex-guard-ai-eight.vercel.app
