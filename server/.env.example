# Server Environment Variables
# Copy this file to .env and fill in your values

# ─── Server ────────────────────────────────────────────
PORT=3001

# ─── Mock Mode (set to "true" to skip GCP calls) ───────
# When MOCK_MODE=true, the server returns realistic sample data
# without needing any GCP credentials. Great for development!
MOCK_MODE=true

# ─── Google Cloud Platform ──────────────────────────────
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Path to your GCP service account key JSON file
# Download from: GCP Console → IAM → Service Accounts → Keys
GOOGLE_APPLICATION_CREDENTIALS=./service-account-key.json

# ─── Google Cloud Storage ───────────────────────────────
GCS_BUCKET_NAME=lexguard-documents

# ─── Vertex AI ──────────────────────────────────────────
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_MODEL=gemini-1.5-pro

# ─── Firestore ──────────────────────────────────────────
# Uses the GOOGLE_CLOUD_PROJECT above
# Collection name for analysis results
FIRESTORE_COLLECTION=analyses
FIRESTORE_REPORTS_COLLECTION=reports

# ─── CORS ───────────────────────────────────────────────
CLIENT_URL=http://localhost:5173
